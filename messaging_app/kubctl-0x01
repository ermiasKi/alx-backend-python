#!/usr/bin/env bash
set -euo pipefail

DEPLOYMENT_NAME="${DEPLOYMENT_NAME:-messaging-app-blue}"
REPLICAS="${REPLICAS:-3}"
NAMESPACE="${NAMESPACE:-default}"
SERVICE_URL_CMD="minikube service --url messaging-app || true"

echo "Scaling deployment ${DEPLOYMENT_NAME} to ${REPLICAS} replicas..."
kubectl scale deployment "${DEPLOYMENT_NAME}" --replicas="${REPLICAS}"

echo "Waiting for rollout to complete..."
kubectl rollout status deployment/"${DEPLOYMENT_NAME}" --timeout=120s

echo "Pods now:"
kubectl get pods -l app=messaging-app -o wide

# Show resource usage (metrics-server must be enabled)
echo "kubectl top nodes (requires metrics-server addon)"
kubectl top nodes || echo "kubectl top nodes failed (metrics-server may not be running)."

echo "kubectl top pods (requires metrics-server addon)"
kubectl top pods || echo "kubectl top pods failed (metrics-server may not be running)."

# Simple load test with wrk if available
if command -v wrk >/dev/null 2>&1; then
  echo "wrk installed — running a brief load test (10s, 10 connections) against service URL..."
  SVC_URL=$(eval ${SERVICE_URL_CMD} | head -n1 || true)
  if [ -n "$SVC_URL" ]; then
    TARGET="${SVC_URL}api/"  # assuming /api/ path
    echo "Target: $TARGET"
    wrk -t2 -c10 -d10s "$TARGET"
  else
    echo "Could not determine service URL. Use minikube service messaging-app --url"
  fi
else
  echo "wrk not installed. Install wrk for load testing (optional)."
fi

echo "Done."
